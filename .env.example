NEXT_PUBLIC_DEMO_MODE=true
LAUNCHES_ENABLED=false
APP_ORIGIN=http://localhost:3100
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_URL=
REDIS_URL=
REDIS_KEY_PREFIX=haus:
NEXT_PUBLIC_STUDIO_PREVIEW_BYPASS=false
LAUNCH_ENCRYPTION_KEY=
METADATA_PROVIDER=pinata
PINATA_JWT=
PINATA_GATEWAY=https://ipfs.io/ipfs

# Optional: enables atomic initial buys after the frozen table is verified.
HAUS_LAUNCH_LOOKUP_TABLE=

# Deferred vault system. Not required for current creator-recipient launches.
# Set only after local-validator tests, deployment and release verification.
HAUS_VAULT_PROGRAM_ID=
HAUS_VAULT_RELEASE_APPROVED=false

# Dedicated low-balance worker, NOT the owner/upgrade-authority keypair.
HAUS_WORKER_ENABLED=false
HAUS_WORKER_KEYPAIR_PATH=
HAUS_SNAPSHOT_POLICY_APPROVED=false
HAUS_EXCLUDED_OWNERS=
