{
  "name": "haus-launchpad",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "pnpm": {
    "overrides": {
      "rpc-websockets>uuid": "11.1.0"
    }
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "test": "tsc -p tsconfig.tests.json && node --test test-results/tests/*.test.js",
    "start": "next start -p 3100",
    "worker:build": "tsc -p tsconfig.worker.json",
    "worker:check": "node .worker-build/scripts/fee-worker.js",
    "worker:run": "node .worker-build/scripts/fee-worker.js --execute",
    "deployment:check": "node scripts/deployment-check.cjs",
    "vault:build": "powershell -NoProfile -File scripts/build-vault.ps1",
    "vault:test": "powershell -NoProfile -File scripts/test-vault.ps1",
    "infrastructure:check": "node scripts/infrastructure-check.cjs",
    "launch-table:plan": "node .worker-build/scripts/launch-table-plan.js"
  },
  "dependencies": {
    "@next/env": "15.5.25",
    "next": "^15.5.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@solana/web3.js": "^1.98.4",
    "@solana/spl-token": "^0.4.14",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-phantom": "^0.9.28",
    "@solana/wallet-adapter-solflare": "^0.6.32",
    "@pump-fun/pump-sdk": "2.0.0",
    "@coral-xyz/anchor": "^0.31.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "ioredis": "^5.8.2",
    "tweetnacl": "^1.0.3",
    "bs58": "^6.0.0",
    "zod": "^3.25.76",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0"
  }
}
